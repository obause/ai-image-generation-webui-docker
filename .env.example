# Put actual values in ~/.config/runpod-workspace/secrets.env (chmod 600), or use
# environment variables from a secret manager. Never commit the real file.
RUNPOD_API_KEY=<RUNPOD_API_KEY>
B2_APPLICATION_KEY_ID=<B2_APPLICATION_KEY_ID>
B2_APPLICATION_KEY=<B2_APPLICATION_KEY>
# Optional: enables authenticated Civitai downloads from the InvokeAI UI.
CIVITAI_API_TOKEN=<CIVITAI_API_TOKEN>
WORKSPACE_WEB_PASSWORD=<LONG_UNIQUE_WEB_PASSWORD>
